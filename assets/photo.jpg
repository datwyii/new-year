<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <!-- Background -->
  <rect width="400" height="400" fill="#FFE6F0"/>
  
  <!-- Large heart in center -->
  <defs>
    <radialGradient id="heartGradient" cx="50%" cy="50%">
      <stop offset="0%" style="stop-color:#FF69B4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF1493;stop-opacity:1" />
    </radialGradient>
  </defs>
  
  <!-- Main heart shape -->
  <path d="M200,350 C200,350 50,250 50,150 C50,100 75,75 100,75 C125,75 150,87.5 200,125 C250,87.5 275,75 300,75 C325,75 350,100 350,150 C350,250 200,350 200,350 Z" 
        fill="url(#heartGradient)" 
        stroke="#FF1493" 
        stroke-width="3"/>
  
  <!-- Decorative smaller hearts -->
  <circle cx="100" cy="100" r="8" fill="#FFB6D9" opacity="0.8"/>
  <circle cx="300" cy="100" r="8" fill="#FFB6D9" opacity="0.8"/>
  <circle cx="80" cy="180" r="6" fill="#FFC0DD" opacity="0.7"/>
  <circle cx="320" cy="180" r="6" fill="#FFC0DD" opacity="0.7"/>
  
  <!-- Small decorative hearts -->
  <text x="60" y="70" font-size="20" fill="#FF69B4">💕</text>
  <text x="320" y="70" font-size="20" fill="#FF69B4">💕</text>
  <text x="50" y="300" font-size="20" fill="#FF69B4">💖</text>
  <text x="330" y="300" font-size="20" fill="#FF69B4">💖</text>
  
  <!-- Center text -->
  <text x="200" y="200" font-family="Arial, sans-serif" font-size="36" fill="white" text-anchor="middle" font-weight="bold">💝</text>
  
  <!-- Sparkles -->
  <text x="150" y="120" font-size="16" fill="#FFD700">✨</text>
  <text x="250" y="120" font-size="16" fill="#FFD700">✨</text>
  <text x="130" y="260" font-size="16" fill="#FFD700">⭐</text>
  <text x="270" y="260" font-size="16" fill="#FFD700">⭐</text>
</svg>
